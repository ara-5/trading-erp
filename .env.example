# Used by docker-compose.yml for the full-stack setup (`docker compose up`). Copy this file to `.env`
# and set at least JWT_SECRET — docker compose reads `.env` from this directory automatically.
#
# Running only Postgres for local (non-Docker) development? You still need this file to exist with a
# JWT_SECRET set, even though that service doesn't use it — compose validates every service up front.
#
# Not used when running the API/web directly with `npm run dev` — that reads apps/api/.env and
# apps/web/.env.local instead (see each app's .env.example).

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional overrides — sensible defaults are baked into docker-compose.yml
# SEED_ADMIN_EMAIL=admin@erp.local
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_FORCE_PASSWORD_CHANGE=true
# DEMO_MODE=false
# ANTHROPIC_API_KEY=
# COPILOT_MODEL=claude-opus-5
