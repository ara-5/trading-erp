DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"
PORT=3001

# Auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS=7
# Set to true when served over HTTPS
COOKIE_SECURE=false

# HTTP
CORS_ORIGIN="http://localhost:3000"
TRUST_PROXY="loopback"
RATE_LIMIT=600          # requests per minute per IP
LOGIN_RATE_LIMIT=10     # login attempts per minute per IP
SWAGGER=true            # serve API docs at /api/docs

# Read-only public demo: rejects every non-GET request
DEMO_MODE=false

# AI copilot (chat over read-only business data + supplier-bill document extraction)
# Leave blank to disable — the UI hides the copilot and extraction buttons automatically.
ANTHROPIC_API_KEY=""
COPILOT_MODEL="claude-opus-5"
COPILOT_DAILY_LIMIT=50        # shared cap across all users, resets at UTC midnight
COPILOT_CHAT_RATE_LIMIT=20    # chat requests per minute per IP
COPILOT_EXTRACT_RATE_LIMIT=10 # document extractions per minute per IP

# Seeding
SEED_ADMIN_EMAIL="admin@erp.local"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_FORCE_PASSWORD_CHANGE=true
